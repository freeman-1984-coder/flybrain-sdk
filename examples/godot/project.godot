config_version=5
[application]
config/name="flybrain-sdk — Godot CPU adapter"
run/main_scene="res://main.tscn"
[display]
window/size/viewport_width=900
window/size/viewport_height=640
[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.95, 0.97, 1, 1)
