include README.md LICENSE CONTRIBUTING.md
recursive-include examples *.py
recursive-include scripts *.py
recursive-include models *.json *.md
recursive-include tests *.py
recursive-include docs *.md
recursive-include site *.json *.html *.css *.txt *.xml .nojekyll
recursive-include .github *.yml *.md
include packages/js/package.json packages/js/package-lock.json packages/js/tsconfig.json
include packages/js/README.md
recursive-include packages/js/src *.ts
global-exclude *.py[cod] .DS_Store
